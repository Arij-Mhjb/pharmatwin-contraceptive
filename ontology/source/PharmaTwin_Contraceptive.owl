    <rdfs:comment xml:lang="fr">Classe caractérisée par la présence d’au moins un œstrogène et d’un progestatif.</rdfs:comment>
  </owl:Class>
  <ptc:ContraceptifHormonal rdf:about="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:nomContraceptif>Pilule combinée EE/acétate de cyprotérone - démonstration</ptc:nomContraceptif>
    <ptc:forme>pilule combinée</ptc:forme>
    <ptc:contientOestrogene>
      <ptc:Oestrogene rdf:about="https://pharmatwin.ai/contraceptive#Ethinylestradiol">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomMolecule>Éthinylestradiol</ptc:nomMolecule>
        <ptc:formuleChimique>C20H24O2</ptc:formuleChimique>
        <ptc:aAffinitePour rdf:resource="https://pharmatwin.ai/contraceptive#RecepteurEstrogene"/>
        <ptc:metabolisePar rdf:resource="https://pharmatwin.ai/contraceptive#CYP3A4"/>
        <ptc:estAssocieAEffet rdf:resource="https://pharmatwin.ai/contraceptive#RisqueThromboembolique"/>
        <ptc:estAssocieAEffet rdf:resource="https://pharmatwin.ai/contraceptive#RisqueAVCIschemique"/>
        <ptc:estAssocieAEffet rdf:resource="https://pharmatwin.ai/contraceptive#ElevationTension"/>
        <rdfs:label xml:lang="fr">Éthinylestradiol</rdfs:label>
      </ptc:Oestrogene>
    </ptc:contientOestrogene>
    <ptc:contientProgestatif rdf:resource="https://pharmatwin.ai/contraceptive#CyproteroneAcetate"/>
    <ptc:peutProduire>
      <ptc:RisqueTumoral rdf:about="https://pharmatwin.ai/contraceptive#RisqueCancerSein">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Légère augmentation relative du risque de cancer du sein chez les utilisatrices actuelles ou récentes de contraceptifs hormonaux ; le risque absolu reste faible et diminue après l'arrêt.</ptc:descriptionEffet>
        <ptc:niveauGravite>grave</ptc:niveauGravite>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_Morch_NEJM2017"/>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Monographie_IARC_100A"/>
        <ptc:frequenceRisque>risque absolu faible</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Risque de cancer du sein</rdfs:label>
      </ptc:RisqueTumoral>
    </ptc:peutProduire>
    <ptc:peutProduire>
      <ptc:RisqueTumoral rdf:about="https://pharmatwin.ai/contraceptive#RisqueCancerColUterin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Risque accru en cas d'utilisation prolongée (plusieurs années), surtout avec une infection persistante par HPV ; le dépistage reste indispensable.</ptc:descriptionEffet>
        <ptc:niveauGravite>grave</ptc:niveauGravite>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_ICESCC_Lancet2007"/>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Monographie_IARC_100A"/>
        <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#InfectionHPVPersistante"/>
        <ptc:frequenceRisque>risque absolu faible</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Risque de cancer du col utérin</rdfs:label>
      </ptc:RisqueTumoral>
    </ptc:peutProduire>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueTumeurHepatique"/>
    <ptc:peutProduire>
      <ptc:RisqueCardiovasculaire rdf:about="https://pharmatwin.ai/contraceptive#RisqueAVCIschemique">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Légère augmentation du risque d'AVC ischémique et d'infarctus sous contraceptifs combinés ; risque absolu faible mais plus élevé avec le tabac, l'hypertension, la migraine avec aura et l'âge.</ptc:descriptionEffet>
        <ptc:niveauGravite>grave</ptc:niveauGravite>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_Lidegaard_NEJM2012"/>
        <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#Tabagisme"/>
        <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#Hypertension"/>
        <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#MigraineAvecAura"/>
        <ptc:frequenceRisque>rare</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Risque d’AVC ischémique</rdfs:label>
      </ptc:RisqueCardiovasculaire>
    </ptc:peutProduire>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#ElevationTension"/>
    <ptc:peutProduire>
      <ptc:EffetNeuropsychiatrique rdf:about="https://pharmatwin.ai/contraceptive#RisqueDepression">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Association statistique avec un diagnostic de dépression ou un traitement antidépresseur dans une grande cohorte ; la causalité individuelle est débattue et la réponse varie selon les personnes.</ptc:descriptionEffet>
        <ptc:niveauGravite>modéré à grave</ptc:niveauGravite>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_Skovlund_JAMAPsy2016"/>
        <ptc:frequenceRisque>variable</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Risque de dépression</rdfs:label>
      </ptc:EffetNeuropsychiatrique>
    </ptc:peutProduire>
    <ptc:peutProduire>
      <ptc:EffetHepatobiliaire rdf:about="https://pharmatwin.ai/contraceptive#LithiaseBiliaire">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Risque modérément augmenté de calculs biliaires chez certaines utilisatrices de contraceptifs hormonaux.</ptc:descriptionEffet>
        <ptc:niveauGravite>modéré</ptc:niveauGravite>
        <ptc:frequenceRisque>peu fréquent</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Lithiase biliaire</rdfs:label>
      </ptc:EffetHepatobiliaire>
    </ptc:peutProduire>
    <ptc:peutProduire>
      <ptc:EffetNeuropsychiatrique rdf:about="https://pharmatwin.ai/contraceptive#BaisseLibido">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Baisse de libido rapportée par certaines utilisatrices ; causalité et intensité variables.</ptc:descriptionEffet>
        <ptc:niveauGravite>léger à modéré</ptc:niveauGravite>
        <ptc:frequenceRisque>variable</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Baisse de libido</rdfs:label>
      </ptc:EffetNeuropsychiatrique>
    </ptc:peutProduire>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueThromboembolique"/>
    <ptc:peutProduire>
      <ptc:EffetNeuropsychiatrique rdf:about="https://pharmatwin.ai/contraceptive#ModificationHumeur">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Symptôme rapporté dont la causalité et l'intensité varient selon les personnes</ptc:descriptionEffet>
        <rdfs:label xml:lang="fr">Modification de l’humeur</rdfs:label>
      </ptc:EffetNeuropsychiatrique>
    </ptc:peutProduire>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueMeningiome"/>
    <ptc:peutProcurer>
      <ptc:EffetBenefique rdf:about="https://pharmatwin.ai/contraceptive#ReductionRisqueCancerOvaire">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Réduction du risque de cancer de l'ovaire avec les contraceptifs combinés, qui persiste après l'arrêt.</ptc:descriptionEffet>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_Ovaire_Lancet2008"/>
        <rdfs:label xml:lang="fr">Réduction du risque de cancer de l’ovaire</rdfs:label>
      </ptc:EffetBenefique>
    </ptc:peutProcurer>
    <ptc:peutProcurer>
      <ptc:EffetBenefique rdf:about="https://pharmatwin.ai/contraceptive#ReductionRisqueCancerEndometre">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Réduction du risque de cancer de l'endomètre avec les contraceptifs combinés.</ptc:descriptionEffet>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_Endometre_LancetOncol2015"/>
        <rdfs:label xml:lang="fr">Réduction du risque de cancer de l’endomètre</rdfs:label>
      </ptc:EffetBenefique>
    </ptc:peutProcurer>
    <ptc:peutProcurer>
      <ptc:EffetBenefique rdf:about="https://pharmatwin.ai/contraceptive#RegularisationSaignements">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Régularisation des saignements et diminution des règles douloureuses chez certaines femmes (sans traiter la cause).</ptc:descriptionEffet>
        <rdfs:label xml:lang="fr">Régularisation des saignements</rdfs:label>
      </ptc:EffetBenefique>
    </ptc:peutProcurer>
    <ptc:peutProcurer rdf:resource="https://pharmatwin.ai/contraceptive#AmeliorationAcne"/>
    <ptc:aContreIndication>
      <ptc:ContreIndicationVasculaire rdf:about="https://pharmatwin.ai/contraceptive#CI_CHC_MigraineAura">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:concerneCondition rdf:resource="https://pharmatwin.ai/contraceptive#MigraineAvecAura"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <ptc:categorieMEC rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ptc:categorieMEC>
        <ptc:niveauAlerte>signal rouge</ptc:niveauAlerte>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Guide_CDC_USMEC_2024"/>
        <rdfs:label xml:lang="fr">Contre-indication CHC – migraine avec aura</rdfs:label>
      </ptc:ContreIndicationVasculaire>
    </ptc:aContreIndication>
    <ptc:aContreIndication>
      <ptc:ContreIndicationOncologique rdf:about="https://pharmatwin.ai/contraceptive#CI_Hormonal_CancerSeinActuel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:concerneCondition rdf:resource="https://pharmatwin.ai/contraceptive#CancerSeinActuel"/>
        <ptc:niveauAlerte>signal rouge</ptc:niveauAlerte>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Guide_CDC_USMEC_2024"/>
        <ptc:categorieMEC rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ptc:categorieMEC>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleProgestative_DSG"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#Implant_ETG"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#DIU_Hormonal_LNG"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#Injectable_DMPA"/>
        <rdfs:label xml:lang="fr">Contre-indication hormonale – cancer du sein actuel</rdfs:label>
      </ptc:ContreIndicationOncologique>
    </ptc:aContreIndication>
    <ptc:aContreIndication>
      <ptc:ContreIndicationOncologique rdf:about="https://pharmatwin.ai/contraceptive#CI_CHC_TumeurHepatique">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:concerneCondition rdf:resource="https://pharmatwin.ai/contraceptive#TumeurHepatique"/>
        <ptc:niveauAlerte>signal rouge</ptc:niveauAlerte>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Guide_CDC_USMEC_2024"/>
        <ptc:categorieMEC rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ptc:categorieMEC>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <rdfs:label xml:lang="fr">Contre-indication CHC – tumeur hépatique</rdfs:label>
      </ptc:ContreIndicationOncologique>
    </ptc:aContreIndication>
    <ptc:aContreIndication>
      <ptc:ContreIndicationVasculaire rdf:about="https://pharmatwin.ai/contraceptive#CI_CHC_AntecedentThrombose">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:concerneCondition rdf:resource="https://pharmatwin.ai/contraceptive#AntecedentThrombose"/>
        <ptc:niveauAlerte>signal rouge ou orange selon le risque de récidive (catégorie MEC à vérifier dans le tableau)</ptc:niveauAlerte>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Guide_CDC_USMEC_2024"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <rdfs:label xml:lang="fr">Contre-indication CHC – antécédent de thrombose</rdfs:label>
      </ptc:ContreIndicationVasculaire>
    </ptc:aContreIndication>
    <ptc:aContreIndication>
      <ptc:ContreIndicationOncologique rdf:about="https://pharmatwin.ai/contraceptive#CI_CPA_Meningiome">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:concerneCondition rdf:resource="https://pharmatwin.ai/contraceptive#AntecedentMeningiome"/>
        <ptc:niveauAlerte>signal rouge</ptc:niveauAlerte>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_PRAC_Meningiome"/>
        <ptc:concerneContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <rdfs:label xml:lang="fr">Contre-indication cyprotérone – antécédent de méningiome</rdfs:label>
      </ptc:ContreIndicationOncologique>
    </ptc:aContreIndication>
    <rdfs:label xml:lang="fr">Pilule EE / acétate de cyprotérone (démonstration)</rdfs:label>
  </ptc:ContraceptifHormonal>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#Progestatif">
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#Molecule"/>
    <rdfs:label xml:lang="fr">Progestatif</rdfs:label>
    <rdfs:comment xml:lang="fr">Molécule progestative de la classification.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#Interaction">
    <rdfs:label xml:lang="fr">Interaction</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation pharmacologique ou clinique pouvant modifier une propriété ou une efficacité étudiée.</rdfs:comment>
  </owl:Class>
  <ptc:EtudeClinique rdf:about="https://pharmatwin.ai/contraceptive#Etude_Endometre_LancetOncol2015">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:titreSource>Endometrial cancer and oral contraceptives : individual participant meta-analysis (Lancet Oncol, 2015)</ptc:titreSource>
    <ptc:niveauPreuve>méta-analyse de données individuelles</ptc:niveauPreuve>
    <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
    <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
    <rdfs:label xml:lang="fr">Méta-analyse sur le cancer de l’endomètre (2015)</rdfs:label>
  </ptc:EtudeClinique>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ConditionOncologique">
    <rdfs:label xml:lang="fr">Condition oncologique</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#ConditionClinique"/>
    <rdfs:comment xml:lang="fr">Condition clinique liée à une situation ou à un antécédent oncologique.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#RisqueTumoral">
    <rdfs:label xml:lang="fr">Risque tumoral (cancer ou tumeur)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#EffetIndesirable"/>
    <rdfs:comment xml:lang="fr">Catégorie d’effets indésirables potentiels de nature tumorale.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ContreIndicationVasculaire">
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#ContreIndication"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N910c5a71d7f54340abfb684eddf24bb6">
        <owl:onProperty rdf:resource="https://pharmatwin.ai/contraceptive#justifiePar"/>
        <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#Etude"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="fr">Contre-indication vasculaire</rdfs:label>
    <rdfs:comment xml:lang="fr">Contre-indication associée à une condition vasculaire ou à un facteur de risque pertinent.</rdfs:comment>
  </owl:Class>
  <ptc:CibleBiologique rdf:about="https://pharmatwin.ai/contraceptive#CYP3A4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:nomCible>Cytochrome P450 3A4</ptc:nomCible>
    <rdfs:label xml:lang="fr">Cytochrome P450 3A4 (CYP3A4)</rdfs:label>
  </ptc:CibleBiologique>
  <ptc:Progestatif rdf:about="https://pharmatwin.ai/contraceptive#Etonogestrel">
    <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ProgestatifFaiblementAndrogenique"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:nomMolecule>Étonogestrel</ptc:nomMolecule>
    <ptc:formuleChimique>C22H28O2</ptc:formuleChimique>
    <ptc:profilAndrogenique>faiblement androgénique</ptc:profilAndrogenique>
    <ptc:aAffinitePour rdf:resource="https://pharmatwin.ai/contraceptive#RecepteurProgesterone"/>
    <ptc:metabolisePar rdf:resource="https://pharmatwin.ai/contraceptive#CYP3A4"/>
    <rdfs:label xml:lang="fr">Étonogestrel</rdfs:label>
  </ptc:Progestatif>
  <ptc:Progestatif rdf:about="https://pharmatwin.ai/contraceptive#Drospirenone">
    <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ProgestatifAntiAndrogenique"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:nomMolecule>Drospirénone</ptc:nomMolecule>
    <ptc:formuleChimique>C24H30O3</ptc:formuleChimique>
    <ptc:profilAndrogenique>anti-androgénique</ptc:profilAndrogenique>
    <ptc:aAffinitePour rdf:resource="https://pharmatwin.ai/contraceptive#RecepteurProgesterone"/>
    <ptc:aAffinitePour rdf:resource="https://pharmatwin.ai/contraceptive#RecepteurAndrogene"/>
    <ptc:metabolisePar rdf:resource="https://pharmatwin.ai/contraceptive#CYP3A4"/>
    <ptc:estAssocieAEffet>
      <ptc:EffetMetabolique rdf:about="https://pharmatwin.ai/contraceptive#RisqueHyperkaliemie">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>La drospirénone a une activité anti-minéralocorticoïde : élévation possible de la kaliémie, surtout en cas d'insuffisance rénale.</ptc:descriptionEffet>
        <ptc:niveauGravite>modéré</ptc:niveauGravite>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Etude_RCP_Drospirenone"/>
        <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#InsuffisanceRenale"/>
        <ptc:frequenceRisque>rare</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Risque d’hyperkaliémie</rdfs:label>
      </ptc:EffetMetabolique>
    </ptc:estAssocieAEffet>
    <rdfs:label xml:lang="fr">Drospirénone</rdfs:label>
  </ptc:Progestatif>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ConditionGynecologique">
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#ConditionClinique"/>
    <rdfs:label xml:lang="fr">Condition gynécologique</rdfs:label>
    <rdfs:comment xml:lang="fr">Condition clinique relevant du domaine gynécologique.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ContraceptifHormonal">
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd56c54b9c4914cc7b5e1806f7f17dff5">
        <owl:onProperty rdf:resource="https://pharmatwin.ai/contraceptive#contientMolecule"/>
        <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#Molecule"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="fr">Contraceptif hormonal</rdfs:label>
    <rdfs:comment xml:lang="fr">Contraceptif associé à au moins une molécule hormonale, suivant la modélisation de l’ontologie.</rdfs:comment>
  </owl:Class>
  <ptc:ConditionClinique rdf:about="https://pharmatwin.ai/contraceptive#TumeurHepatique">
    <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ConditionOncologique"/>
    <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ConditionContreIndiqueCHC"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
