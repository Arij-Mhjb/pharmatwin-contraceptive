        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://pharmatwin.ai/contraceptive#Etude"/>
    <rdfs:label xml:lang="fr">est justifié par</rdfs:label>
    <rdfs:comment xml:lang="fr">Relie une contre-indication, un effet ou une interaction à une source documentaire.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#EffetOsseux">
    <rdfs:label xml:lang="fr">Effet osseux</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#EffetIndesirable"/>
    <rdfs:comment xml:lang="fr">Effet indésirable concernant l’os ou la densité minérale osseuse.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#EffetClinique">
    <rdfs:label xml:lang="fr">Effet clinique</rdfs:label>
