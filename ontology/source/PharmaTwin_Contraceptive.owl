        <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#Etude"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment xml:lang="fr">Contre-indication associée à une condition métabolique ou rénale.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ConditionContreIndiqueCHC">
    <rdfs:label xml:lang="fr">Condition contre-indiquant les contraceptifs combinés</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#ConditionClinique"/>
    <rdfs:comment xml:lang="fr">Condition considérée dans le modèle pour l’analyse des restrictions liées aux contraceptifs hormonaux combinés (CHC).</rdfs:comment>
  </owl:Class>
  <ptc:RisqueCardiovasculaire rdf:about="https://pharmatwin.ai/contraceptive#RisqueThromboembolique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:descriptionEffet>Risque thromboembolique potentiel associé aux contraceptifs hormonaux combinés</ptc:descriptionEffet>
    <ptc:justifiePar>
      <ptc:Etude rdf:about="https://pharmatwin.ai/contraceptive#Evaluation_EMA_CHC">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:titreSource>Combined hormonal contraceptives - EMA review</ptc:titreSource>
        <ptc:urlSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.ema.europa.eu/en/human-regulatory-overview/post-authorisation/referral-procedures-human-medicines/combined-hormonal-contraceptives</ptc:urlSource>
        <ptc:niveauPreuve>évaluation réglementaire</ptc:niveauPreuve>
        <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <rdfs:seeAlso rdf:resource="https://www.ema.europa.eu/en/human-regulatory-overview/post-authorisation/referral-procedures-human-medicines/combined-hormonal-contraceptives"/>
        <rdfs:label xml:lang="fr">Évaluation EMA des contraceptifs hormonaux combinés</rdfs:label>
      </ptc:Etude>
    </ptc:justifiePar>
    <ptc:niveauGravite>grave</ptc:niveauGravite>
    <ptc:frequenceRisque>rare</ptc:frequenceRisque>
    <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#Tabagisme"/>
    <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#Obesite"/>
    <ptc:aggravePar>
      <ptc:ConditionClinique rdf:about="https://pharmatwin.ai/contraceptive#AntecedentThrombose">
        <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#FacteurDeRisque"/>
        <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ConditionContreIndiqueCHC"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomCondition>Antécédent personnel de thrombose</ptc:nomCondition>
        <rdfs:label xml:lang="fr">Antécédent personnel de thrombose</rdfs:label>
      </ptc:ConditionClinique>
    </ptc:aggravePar>
    <rdfs:label xml:lang="fr">Risque thromboembolique</rdfs:label>
  </ptc:RisqueCardiovasculaire>
  <ptc:EffetMetabolique rdf:about="https://pharmatwin.ai/contraceptive#PriseDePoids">
