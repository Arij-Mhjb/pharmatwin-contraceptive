  </owl:DatatypeProperty>
  <ptc:InteractionMedicamenteuse rdf:about="https://pharmatwin.ai/contraceptive#Interaction_Rifampicine_DSG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:concerneMolecule>
      <ptc:Molecule rdf:about="https://pharmatwin.ai/contraceptive#Rifampicine">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomMolecule>Rifampicine</ptc:nomMolecule>
        <ptc:formuleChimique>C43H58N4O12</ptc:formuleChimique>
        <rdfs:label xml:lang="fr">Rifampicine</rdfs:label>
      </ptc:Molecule>
    </ptc:concerneMolecule>
    <ptc:concerneMolecule>
      <ptc:Progestatif rdf:about="https://pharmatwin.ai/contraceptive#Desogestrel">
        <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ProgestatifFaiblementAndrogenique"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomMolecule>Désogestrel</ptc:nomMolecule>
        <ptc:formuleChimique>C22H30O</ptc:formuleChimique>
        <ptc:profilAndrogenique>faiblement androgénique</ptc:profilAndrogenique>
        <ptc:aAffinitePour rdf:resource="https://pharmatwin.ai/contraceptive#RecepteurProgesterone"/>
        <ptc:metabolisePar rdf:resource="https://pharmatwin.ai/contraceptive#CYP3A4"/>
        <rdfs:label xml:lang="fr">Désogestrel</rdfs:label>
      </ptc:Progestatif>
    </ptc:concerneMolecule>
    <ptc:modifieEfficaciteDe>
      <ptc:ContraceptifHormonal rdf:about="https://pharmatwin.ai/contraceptive#PiluleProgestative_DSG">
        <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#PiluleProgestative"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomContraceptif>Pilule progestative désogestrel - démonstration</ptc:nomContraceptif>
        <ptc:forme>pilule progestative seule</ptc:forme>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#SaignementsIrreguliers"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueCancerSein"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueDepression"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#BaisseLibido"/>
        <ptc:contientProgestatif rdf:resource="https://pharmatwin.ai/contraceptive#Desogestrel"/>
        <ptc:aContreIndication rdf:resource="https://pharmatwin.ai/contraceptive#CI_Hormonal_CancerSeinActuel"/>
        <rdfs:label xml:lang="fr">Pilule progestative au désogestrel (démonstration)</rdfs:label>
      </ptc:ContraceptifHormonal>
    </ptc:modifieEfficaciteDe>
    <ptc:niveauAlerte>à vérifier avec un professionnel</ptc:niveauAlerte>
    <ptc:justifiePar>
      <ptc:Etude rdf:about="https://pharmatwin.ai/contraceptive#Guide_CDC_USMEC_2024">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:titreSource>U.S. Medical Eligibility Criteria for Contraceptive Use, 2024</ptc:titreSource>
        <ptc:urlSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cdc.gov/mmwr/volumes/73/rr/rr7304a1.htm</ptc:urlSource>
        <ptc:niveauPreuve>recommandation officielle</ptc:niveauPreuve>
        <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <rdfs:seeAlso rdf:resource="https://www.cdc.gov/mmwr/volumes/73/rr/rr7304a1.htm"/>
        <rdfs:label xml:lang="fr">Guide CDC – U.S. MEC 2024</rdfs:label>
      </ptc:Etude>
    </ptc:justifiePar>
    <rdfs:label xml:lang="fr">Interaction rifampicine – désogestrel</rdfs:label>
  </ptc:InteractionMedicamenteuse>
