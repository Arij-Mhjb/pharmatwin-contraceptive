  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#PiluleCombinee">
    <rdfs:label xml:lang="fr">Pilule combinée</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#ContraceptifHormonal"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N50ad8fcbc78247a388a761564c60fcca">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://pharmatwin.ai/contraceptive#Contraceptif"/>
          <owl:Restriction rdf:nodeID="N92c5463c818d49fb811d931ece069971">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://pharmatwin.ai/contraceptive#contientOestrogene">
                <rdfs:label xml:lang="fr">contient un œstrogène</rdfs:label>
                <rdfs:domain rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
                <rdfs:range rdf:resource="https://pharmatwin.ai/contraceptive#Oestrogene"/>
                <rdfs:subPropertyOf rdf:resource="https://pharmatwin.ai/contraceptive#contientMolecule"/>
                <rdfs:comment xml:lang="fr">Indique la présence d’un œstrogène dans un contraceptif.</rdfs:comment>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#Oestrogene"/>
          </owl:Restriction>
          <owl:Restriction rdf:nodeID="Nd185433adfa142ae977d125bf7c796cd">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://pharmatwin.ai/contraceptive#contientProgestatif">
                <rdfs:label xml:lang="fr">contient un progestatif</rdfs:label>
                <rdfs:domain rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
                <rdfs:range rdf:resource="https://pharmatwin.ai/contraceptive#Progestatif"/>
                <rdfs:subPropertyOf rdf:resource="https://pharmatwin.ai/contraceptive#contientMolecule"/>
                <rdfs:comment xml:lang="fr">Indique la présence d’un progestatif dans un contraceptif.</rdfs:comment>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#Progestatif"/>
          </owl:Restriction>
        </owl:intersectionOf>
