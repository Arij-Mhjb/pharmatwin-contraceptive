  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ContraceptifAvecRisqueTumoral">
    <rdfs:label xml:lang="fr">Contraceptif associé à un risque tumoral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N72109589866d4aa8b56b26762d9fec5d">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://pharmatwin.ai/contraceptive#Contraceptif"/>
          <owl:Restriction rdf:nodeID="Ne25f899c3bc64041b58174b55842a1ab">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://pharmatwin.ai/contraceptive#peutProduire">
                <rdfs:domain rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
                <rdfs:range rdf:resource="https://pharmatwin.ai/contraceptive#EffetClinique"/>
                <rdfs:label xml:lang="fr">peut produire l'effet</rdfs:label>
                <rdfs:comment xml:lang="fr">Associe un contraceptif à un effet clinique potentiel, sans inférer qu’il survient chez une personne.</rdfs:comment>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#RisqueTumoral"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment xml:lang="fr">Classe définie par l’existence d’au moins un lien peutProduire vers un risque tumoral.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://pharmatwin.ai/contraceptive#metabolisePar">
    <rdfs:domain rdf:resource="https://pharmatwin.ai/contraceptive#Molecule"/>
    <rdfs:range rdf:resource="https://pharmatwin.ai/contraceptive#CibleBiologique"/>
    <rdfs:label xml:lang="fr">est métabolisée par</rdfs:label>
    <rdfs:comment xml:lang="fr">Associe une molécule à une cible biologique impliquée dans son métabolisme.</rdfs:comment>
  </owl:ObjectProperty>
