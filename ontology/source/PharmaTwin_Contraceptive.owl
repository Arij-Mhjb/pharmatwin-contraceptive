  <ptc:RisqueCardiovasculaire rdf:about="https://pharmatwin.ai/contraceptive#ElevationTension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:descriptionEffet>Augmentation possible de la pression artérielle sous contraceptifs combinés.</ptc:descriptionEffet>
    <ptc:niveauGravite>modéré</ptc:niveauGravite>
    <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#Hypertension"/>
    <ptc:aggravePar rdf:resource="https://pharmatwin.ai/contraceptive#Obesite"/>
    <ptc:frequenceRisque>peu fréquent</ptc:frequenceRisque>
    <rdfs:label xml:lang="fr">Élévation de la pression artérielle</rdfs:label>
  </ptc:RisqueCardiovasculaire>
  <ptc:EtudeClinique rdf:about="https://pharmatwin.ai/contraceptive#Etude_Skovlund_JAMAPsy2016">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:titreSource>Association of hormonal contraception with depression (JAMA Psychiatry, 2016)</ptc:titreSource>
    <ptc:niveauPreuve>étude de cohorte nationale (causalité débattue)</ptc:niveauPreuve>
    <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
    <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleProgestative_DSG"/>
    <ptc:evalueContraceptif>
      <ptc:ContraceptifHormonal rdf:about="https://pharmatwin.ai/contraceptive#Implant_ETG">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomContraceptif>Implant étonogestrel - démonstration</ptc:nomContraceptif>
        <ptc:forme>implant</ptc:forme>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#SaignementsIrreguliers"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueCancerSein"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueDepression"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#Acne"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#BaisseLibido"/>
        <ptc:contientProgestatif rdf:resource="https://pharmatwin.ai/contraceptive#Etonogestrel"/>
        <ptc:aContreIndication rdf:resource="https://pharmatwin.ai/contraceptive#CI_Hormonal_CancerSeinActuel"/>
        <rdfs:label xml:lang="fr">Implant à l’étonogestrel (démonstration)</rdfs:label>
      </ptc:ContraceptifHormonal>
    </ptc:evalueContraceptif>
    <ptc:evalueContraceptif>
      <ptc:ContraceptifHormonal rdf:about="https://pharmatwin.ai/contraceptive#DIU_Hormonal_LNG">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomContraceptif>DIU hormonal lévonorgestrel - démonstration</ptc:nomContraceptif>
        <ptc:forme>DIU hormonal</ptc:forme>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#SaignementsIrreguliers"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueCancerSein"/>
        <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueDepression"/>
        <ptc:contientProgestatif rdf:resource="https://pharmatwin.ai/contraceptive#Levonorgestrel"/>
        <ptc:aContreIndication rdf:resource="https://pharmatwin.ai/contraceptive#CI_Hormonal_CancerSeinActuel"/>
        <rdfs:label xml:lang="fr">DIU hormonal au lévonorgestrel (démonstration)</rdfs:label>
      </ptc:ContraceptifHormonal>
    </ptc:evalueContraceptif>
    <rdfs:label xml:lang="fr">Étude Skovlund et al. (JAMA Psychiatry, 2016)</rdfs:label>
  </ptc:EtudeClinique>
  <ptc:RisqueTumoral rdf:about="https://pharmatwin.ai/contraceptive#RisqueMeningiome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:descriptionEffet>Association liée à la dose et à la durée avec certains progestatifs (acétate de cyprotérone, acétate de nomégestrol, acétate de chlormadinone) ; tumeur le plus souvent bénigne mais pouvant nécessiter un traitement.</ptc:descriptionEffet>
    <ptc:niveauGravite>grave</ptc:niveauGravite>
    <ptc:justifiePar>
      <ptc:Etude rdf:about="https://pharmatwin.ai/contraceptive#Etude_PRAC_Meningiome">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:titreSource>Évaluations européennes (PRAC/EMA) et ANSM sur le risque de méningiome avec certains progestatifs</ptc:titreSource>
        <ptc:niveauPreuve>évaluation réglementaire (référence exacte à vérifier avant citation)</ptc:niveauPreuve>
        <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <rdfs:label xml:lang="fr">Évaluations réglementaires – risque de méningiome</rdfs:label>
        <rdfs:comment xml:lang="fr">Référence réglementaire non entièrement normalisée dans les données d’origine ; document exact et date à identifier avant citation académique.</rdfs:comment>
      </ptc:Etude>
    </ptc:justifiePar>
    <ptc:frequenceRisque>rare</ptc:frequenceRisque>
    <rdfs:label xml:lang="fr">Risque de méningiome</rdfs:label>
  </ptc:RisqueTumoral>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ProgestatifFaiblementAndrogenique">
    <rdfs:label xml:lang="fr">Progestatif faiblement androgénique</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#Progestatif"/>
    <rdfs:comment xml:lang="fr">Sous-classe de progestatif décrite comme faiblement androgénique.</rdfs:comment>
  </owl:Class>
  <ptc:EffetBenefique rdf:about="https://pharmatwin.ai/contraceptive#AmeliorationAcne">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:descriptionEffet>Amélioration possible de l'acné avec des progestatifs anti-androgéniques.</ptc:descriptionEffet>
    <rdfs:label xml:lang="fr">Amélioration de l’acné</rdfs:label>
  </ptc:EffetBenefique>
  <ptc:RisqueTumoral rdf:about="https://pharmatwin.ai/contraceptive#RisqueTumeurHepatique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:descriptionEffet>Adénome hépatocellulaire, rare, décrit surtout avec une utilisation prolongée de contraceptifs combinés.</ptc:descriptionEffet>
    <ptc:niveauGravite>grave</ptc:niveauGravite>
    <ptc:justifiePar>
      <ptc:Etude rdf:about="https://pharmatwin.ai/contraceptive#Monographie_IARC_100A">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:titreSource>IARC Monographs, volume 100A : contraceptifs combinés œstro-progestatifs (classement groupe 1)</ptc:titreSource>
        <ptc:niveauPreuve>évaluation d'un organisme international</ptc:niveauPreuve>
        <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_DRSP"/>
        <ptc:evalueContraceptif rdf:resource="https://pharmatwin.ai/contraceptive#PiluleCombinee_EE_CPA"/>
        <rdfs:label xml:lang="fr">Monographie du CIRC – volume 100A</rdfs:label>
      </ptc:Etude>
    </ptc:justifiePar>
    <ptc:frequenceRisque>très rare</ptc:frequenceRisque>
    <rdfs:label xml:lang="fr">Risque de tumeur hépatique</rdfs:label>
  </ptc:RisqueTumoral>
  <ptc:Progestatif rdf:about="https://pharmatwin.ai/contraceptive#CyproteroneAcetate">
    <rdf:type rdf:resource="https://pharmatwin.ai/contraceptive#ProgestatifAntiAndrogenique"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:nomMolecule>Acétate de cyprotérone</ptc:nomMolecule>
    <ptc:formuleChimique>C24H29ClO4</ptc:formuleChimique>
    <ptc:profilAndrogenique>anti-androgénique</ptc:profilAndrogenique>
    <ptc:aAffinitePour>
      <ptc:RecepteurHormonal rdf:about="https://pharmatwin.ai/contraceptive#RecepteurProgesterone">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomCible>Récepteur de la progestérone</ptc:nomCible>
        <rdfs:label xml:lang="fr">Récepteur de la progestérone</rdfs:label>
      </ptc:RecepteurHormonal>
    </ptc:aAffinitePour>
    <ptc:aAffinitePour>
      <ptc:RecepteurHormonal rdf:about="https://pharmatwin.ai/contraceptive#RecepteurAndrogene">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomCible>Récepteur des androgènes</ptc:nomCible>
        <rdfs:label xml:lang="fr">Récepteur des androgènes</rdfs:label>
      </ptc:RecepteurHormonal>
    </ptc:aAffinitePour>
    <ptc:estAssocieAEffet rdf:resource="https://pharmatwin.ai/contraceptive#RisqueMeningiome"/>
    <rdfs:label xml:lang="fr">Acétate de cyprotérone</rdfs:label>
  </ptc:Progestatif>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#InteractionMedicamenteuse">
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#Interaction"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N811891ddbd86436d9a5eefd6cc3f6b79">
        <owl:onProperty rdf:resource="https://pharmatwin.ai/contraceptive#concerneMolecule"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="https://pharmatwin.ai/contraceptive#Molecule"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="fr">Interaction médicamenteuse</rdfs:label>
    <rdfs:comment xml:lang="fr">Interaction impliquant au moins deux molécules, selon la restriction ontologique.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ContreIndicationMetabolique">
    <rdfs:label xml:lang="fr">Contre-indication métabolique ou rénale</rdfs:label>
