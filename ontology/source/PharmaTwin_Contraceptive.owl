  <owl:Class rdf:about="https://pharmatwin.ai/contraceptive#ContraceptifAvecEffetBenefique">
    <rdfs:label xml:lang="fr">Contraceptif associé à un effet bénéfique</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N221d7e13c9f847be9ab7d852cb0dfb8d">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://pharmatwin.ai/contraceptive#Contraceptif"/>
          <owl:Restriction rdf:nodeID="N9ee027649b1b409f89cf4973955bb220">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://pharmatwin.ai/contraceptive#peutProcurer">
                <rdfs:label xml:lang="fr">peut procurer</rdfs:label>
                <rdfs:domain rdf:resource="https://pharmatwin.ai/contraceptive#Contraceptif"/>
                <rdfs:range rdf:resource="https://pharmatwin.ai/contraceptive#EffetBenefique"/>
                <rdfs:comment xml:lang="fr">Associe un contraceptif à un effet bénéfique potentiel, sans garantie pour un individu.</rdfs:comment>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://pharmatwin.ai/contraceptive#EffetBenefique"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment xml:lang="fr">Classe définie par l’existence d’au moins un lien peutProcurer vers un effet bénéfique.</rdfs:comment>
  </owl:Class>
