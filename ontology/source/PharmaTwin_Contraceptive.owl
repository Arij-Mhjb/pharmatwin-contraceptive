  <ptc:ContraceptifHormonal rdf:about="https://pharmatwin.ai/contraceptive#Injectable_DMPA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ptc:nomContraceptif>Injection trimestrielle DMPA - démonstration</ptc:nomContraceptif>
    <ptc:forme>injectable</ptc:forme>
    <ptc:contientProgestatif>
      <ptc:Progestatif rdf:about="https://pharmatwin.ai/contraceptive#MedroxyprogesteroneAcetate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:nomMolecule>Acétate de médroxyprogestérone</ptc:nomMolecule>
        <ptc:formuleChimique>C24H34O4</ptc:formuleChimique>
        <ptc:aAffinitePour rdf:resource="https://pharmatwin.ai/contraceptive#RecepteurProgesterone"/>
        <ptc:estAssocieAEffet rdf:resource="https://pharmatwin.ai/contraceptive#PerteDensiteOsseuse"/>
        <ptc:estAssocieAEffet rdf:resource="https://pharmatwin.ai/contraceptive#PriseDePoids"/>
        <rdfs:label xml:lang="fr">Acétate de médroxyprogestérone</rdfs:label>
      </ptc:Progestatif>
    </ptc:contientProgestatif>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueCancerSein"/>
    <ptc:peutProduire>
      <ptc:EffetOsseux rdf:about="https://pharmatwin.ai/contraceptive#PerteDensiteOsseuse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Diminution de la densité minérale osseuse sous DMPA, en partie réversible à l'arrêt.</ptc:descriptionEffet>
        <ptc:niveauGravite>modéré</ptc:niveauGravite>
        <ptc:justifiePar rdf:resource="https://pharmatwin.ai/contraceptive#Guide_CDC_USMEC_2024"/>
        <ptc:frequenceRisque>fréquent sous DMPA</ptc:frequenceRisque>
        <rdfs:label xml:lang="fr">Perte de densité minérale osseuse</rdfs:label>
      </ptc:EffetOsseux>
    </ptc:peutProduire>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#PriseDePoids"/>
    <ptc:peutProduire>
      <ptc:EffetIndesirable rdf:about="https://pharmatwin.ai/contraceptive#SaignementsIrreguliers">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ptc:descriptionEffet>Modification possible du profil de saignement</ptc:descriptionEffet>
        <ptc:niveauGravite>léger</ptc:niveauGravite>
        <rdfs:label xml:lang="fr">Saignements irréguliers</rdfs:label>
      </ptc:EffetIndesirable>
    </ptc:peutProduire>
    <ptc:peutProduire rdf:resource="https://pharmatwin.ai/contraceptive#RisqueDepression"/>
    <ptc:aContreIndication rdf:resource="https://pharmatwin.ai/contraceptive#CI_Hormonal_CancerSeinActuel"/>
    <rdfs:label xml:lang="fr">Contraceptif injectable DMPA (démonstration)</rdfs:label>
  </ptc:ContraceptifHormonal>
