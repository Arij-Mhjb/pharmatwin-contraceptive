    ptc:concerneCondition ptc:TumeurHepatique ;
    ptc:concerneContraceptif ptc:PiluleCombinee_EE_CPA,
        ptc:PiluleCombinee_EE_DRSP ;
    ptc:justifiePar ptc:Guide_CDC_USMEC_2024 ;
    ptc:niveauAlerte "signal rouge" .

ptc:CancerSeinActuel a owl:NamedIndividual,
        ptc:ConditionClinique,
        ptc:ConditionContreIndiqueCHC,
        ptc:ConditionOncologique ;
    rdfs:label "Cancer du sein actuel"@fr ;
    ptc:nomCondition "Cancer du sein actuel" .

ptc:ContraceptifNonHormonal a owl:Class ;
    rdfs:label "Contraceptif non hormonal"@fr ;
    rdfs:comment "Contraceptif ne relevant pas de la catégorie hormonale dans la classification proposée."@fr ;
    rdfs:subClassOf ptc:Contraceptif .

ptc:ContreIndicationVasculaire a owl:Class ;
    rdfs:label "Contre-indication vasculaire"@fr ;
    rdfs:comment "Contre-indication associée à une condition vasculaire ou à un facteur de risque pertinent."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptc:justifiePar ;
            owl:someValuesFrom ptc:Etude ],
        ptc:ContreIndication .

ptc:CyclesIrreguliers a owl:NamedIndividual,
        ptc:ConditionGynecologique ;
    rdfs:label "Cycles irréguliers"@fr ;
    ptc:nomCondition "Cycles irréguliers" .

ptc:Desogestrel a owl:NamedIndividual,
        ptc:Progestatif,
        ptc:ProgestatifFaiblementAndrogenique ;
    rdfs:label "Désogestrel"@fr ;
    ptc:aAffinitePour ptc:RecepteurProgesterone ;
    ptc:formuleChimique "C22H30O" ;
    ptc:metabolisePar ptc:CYP3A4 ;
    ptc:nomMolecule "Désogestrel" ;
    ptc:profilAndrogenique "faiblement androgénique" .

ptc:EffetMetabolique a owl:Class ;
    rdfs:label "Effet métabolique"@fr ;
    rdfs:comment "Effet indésirable lié au métabolisme ou à ses paramètres."@fr ;
    rdfs:subClassOf ptc:EffetIndesirable .

ptc:Endometriose a owl:NamedIndividual,
        ptc:ConditionGynecologique ;
    rdfs:label "Endométriose"@fr ;
    ptc:nomCondition "Endométriose" .

ptc:Ethinylestradiol a owl:NamedIndividual,
        ptc:Oestrogene ;
    rdfs:label "Éthinylestradiol"@fr ;
    ptc:aAffinitePour ptc:RecepteurEstrogene ;
    ptc:estAssocieAEffet ptc:ElevationTension,
        ptc:RisqueAVCIschemique,
        ptc:RisqueThromboembolique ;
    ptc:formuleChimique "C20H24O2" ;
    ptc:metabolisePar ptc:CYP3A4 ;
    ptc:nomMolecule "Éthinylestradiol" .

ptc:Etude_PRAC_Meningiome a owl:NamedIndividual,
        ptc:Etude ;
    rdfs:label "Évaluations réglementaires – risque de méningiome"@fr ;
    rdfs:comment "Référence réglementaire non entièrement normalisée dans les données d’origine ; document exact et date à identifier avant citation académique."@fr ;
    ptc:evalueContraceptif ptc:PiluleCombinee_EE_CPA ;
    ptc:niveauPreuve "évaluation réglementaire (référence exacte à vérifier avant citation)" ;
    ptc:titreSource "Évaluations européennes (PRAC/EMA) et ANSM sur le risque de méningiome avec certains progestatifs" .

ptc:Etude_RCP_Drospirenone a owl:NamedIndividual,
        ptc:Etude ;
    rdfs:label "Résumé des caractéristiques du produit – drospirénone"@fr ;
    ptc:evalueContraceptif ptc:PiluleCombinee_EE_DRSP ;
    ptc:niveauPreuve "document réglementaire (référence exacte à vérifier avant citation)" ;
    ptc:titreSource "Résumé des caractéristiques du produit (RCP) des contraceptifs contenant de la drospirénone" .

ptc:InsuffisanceRenale a owl:NamedIndividual,
        ptc:ConditionClinique ;
    rdfs:label "Insuffisance rénale"@fr ;
    ptc:nomCondition "Insuffisance rénale" .

ptc:LithiaseBiliaire a owl:NamedIndividual,
        ptc:EffetHepatobiliaire ;
    rdfs:label "Lithiase biliaire"@fr ;
    ptc:descriptionEffet "Risque modérément augmenté de calculs biliaires chez certaines utilisatrices de contraceptifs hormonaux." ;
    ptc:frequenceRisque "peu fréquent" ;
    ptc:niveauGravite "modéré" .

ptc:ModificationHumeur a owl:NamedIndividual,
        ptc:EffetNeuropsychiatrique ;
    rdfs:label "Modification de l’humeur"@fr ;
    ptc:descriptionEffet "Symptôme rapporté dont la causalité et l'intensité varient selon les personnes" .

ptc:PerteDensiteOsseuse a owl:NamedIndividual,
        ptc:EffetOsseux ;
    rdfs:label "Perte de densité minérale osseuse"@fr ;
    ptc:descriptionEffet "Diminution de la densité minérale osseuse sous DMPA, en partie réversible à l'arrêt." ;
    ptc:frequenceRisque "fréquent sous DMPA" ;
    ptc:justifiePar ptc:Guide_CDC_USMEC_2024 ;
    ptc:niveauGravite "modéré" .

ptc:PiluleProgestative a owl:Class ;
    rdfs:label "Pilule progestative seule"@fr ;
    rdfs:comment "Classe représentant une pilule progestative seule, avec restriction sur la présence d’œstrogène."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass ptc:Oestrogene ;
            owl:onProperty ptc:contientOestrogene ],
        [ a owl:Restriction ;
            owl:onProperty ptc:contientProgestatif ;
            owl:someValuesFrom ptc:Progestatif ],
        ptc:ContraceptifHormonal .

ptc:PriseDePoids a owl:NamedIndividual,
        ptc:EffetMetabolique ;
    rdfs:label "Prise de poids"@fr ;
    ptc:descriptionEffet "Prise de poids décrite avec l'injectable DMPA ; relation moins claire avec les autres méthodes." ;
    ptc:frequenceRisque "variable" ;
    ptc:niveauGravite "léger" .

ptc:ProfilRisqueVasculaire a owl:Class ;
    rdfs:label "Profil avec facteur de risque vasculaire"@fr ;
    rdfs:comment "Profil synthétique catégorisé par les données et restrictions de risque vasculaire de l’ontologie."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptc:aCondition ;
            owl:someValuesFrom ptc:ConditionClinique ],
        ptc:ProfilPatiente .

ptc:ProgestatifAndrogenique a owl:Class ;
    rdfs:label "Progestatif androgénique"@fr ;
    rdfs:comment "Sous-classe de progestatif décrite comme androgénique."@fr ;
    rdfs:subClassOf ptc:Progestatif .

ptc:ReductionRisqueCancerEndometre a owl:NamedIndividual,
        ptc:EffetBenefique ;
    rdfs:label "Réduction du risque de cancer de l’endomètre"@fr ;
    ptc:descriptionEffet "Réduction du risque de cancer de l'endomètre avec les contraceptifs combinés." ;
    ptc:justifiePar ptc:Etude_Endometre_LancetOncol2015 .

ptc:ReductionRisqueCancerOvaire a owl:NamedIndividual,
        ptc:EffetBenefique ;
    rdfs:label "Réduction du risque de cancer de l’ovaire"@fr ;
    ptc:descriptionEffet "Réduction du risque de cancer de l'ovaire avec les contraceptifs combinés, qui persiste après l'arrêt." ;
    ptc:justifiePar ptc:Etude_Ovaire_Lancet2008 .

ptc:RegularisationSaignements a owl:NamedIndividual,
        ptc:EffetBenefique ;
    rdfs:label "Régularisation des saignements"@fr ;
    ptc:descriptionEffet "Régularisation des saignements et diminution des règles douloureuses chez certaines femmes (sans traiter la cause)." .

ptc:RisqueCancerColUterin a owl:NamedIndividual,
        ptc:RisqueTumoral ;
    rdfs:label "Risque de cancer du col utérin"@fr ;
    ptc:aggravePar ptc:InfectionHPVPersistante ;
    ptc:descriptionEffet "Risque accru en cas d'utilisation prolongée (plusieurs années), surtout avec une infection persistante par HPV ; le dépistage reste indispensable." ;
    ptc:frequenceRisque "risque absolu faible" ;
    ptc:justifiePar ptc:Etude_ICESCC_Lancet2007,
        ptc:Monographie_IARC_100A ;
    ptc:niveauGravite "grave" .

ptc:RisqueHyperkaliemie a owl:NamedIndividual,
        ptc:EffetMetabolique ;
    rdfs:label "Risque d’hyperkaliémie"@fr ;
    ptc:aggravePar ptc:InsuffisanceRenale ;
    ptc:descriptionEffet "La drospirénone a une activité anti-minéralocorticoïde : élévation possible de la kaliémie, surtout en cas d'insuffisance rénale." ;
    ptc:frequenceRisque "rare" ;
    ptc:justifiePar ptc:Etude_RCP_Drospirenone ;
    ptc:niveauGravite "modéré" .

ptc:RisqueMeningiome a owl:NamedIndividual,
        ptc:RisqueTumoral ;
    rdfs:label "Risque de méningiome"@fr ;
    ptc:descriptionEffet "Association liée à la dose et à la durée avec certains progestatifs (acétate de cyprotérone, acétate de nomégestrol, acétate de chlormadinone) ; tumeur le plus souvent bénigne mais pouvant nécessiter un traitement." ;
    ptc:frequenceRisque "rare" ;
    ptc:justifiePar ptc:Etude_PRAC_Meningiome ;
    ptc:niveauGravite "grave" .

ptc:RisqueTumeurHepatique a owl:NamedIndividual,
        ptc:RisqueTumoral ;
    rdfs:label "Risque de tumeur hépatique"@fr ;
    ptc:descriptionEffet "Adénome hépatocellulaire, rare, décrit surtout avec une utilisation prolongée de contraceptifs combinés." ;
    ptc:frequenceRisque "très rare" ;
    ptc:justifiePar ptc:Monographie_IARC_100A ;
    ptc:niveauGravite "grave" .

ptc:SOPK a owl:NamedIndividual,
        ptc:ConditionGynecologique ;
    rdfs:label "Syndrome des ovaires polykystiques (SOPK)"@fr ;
    ptc:nomCondition "Syndrome des ovaires polykystiques" .

ptc:contientOestrogene a owl:ObjectProperty ;
    rdfs:label "contient un œstrogène"@fr ;
    rdfs:comment "Indique la présence d’un œstrogène dans un contraceptif."@fr ;
    rdfs:domain ptc:Contraceptif ;
    rdfs:range ptc:Oestrogene ;
    rdfs:subPropertyOf ptc:contientMolecule .

ptc:contientProgestatif a owl:ObjectProperty ;
    rdfs:label "contient un progestatif"@fr ;
    rdfs:comment "Indique la présence d’un progestatif dans un contraceptif."@fr ;
    rdfs:domain ptc:Contraceptif ;
    rdfs:range ptc:Progestatif ;
    rdfs:subPropertyOf ptc:contientMolecule .

ptc:Acne a owl:NamedIndividual,
        ptc:EffetClinique,
        ptc:EffetIndesirable ;
    rdfs:label "Acné"@fr ;
    ptc:descriptionEffet "Acné rapportée dans le journal de tolérance simulé" ;
    ptc:niveauGravite "léger à modéré" .

ptc:ConditionOncologique a owl:Class ;
    rdfs:label "Condition oncologique"@fr ;
    rdfs:comment "Condition clinique liée à une situation ou à un antécédent oncologique."@fr ;
    rdfs:subClassOf ptc:ConditionClinique .

ptc:ContreIndicationOncologique a owl:Class ;
    rdfs:label "Contre-indication oncologique"@fr ;
    rdfs:comment "Contre-indication associée à une condition oncologique."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptc:justifiePar ;
            owl:someValuesFrom ptc:Etude ],
        ptc:ContreIndication .

ptc:DIU_Hormonal_LNG a owl:NamedIndividual,
        ptc:ContraceptifHormonal ;
    rdfs:label "DIU hormonal au lévonorgestrel (démonstration)"@fr ;
    ptc:aContreIndication ptc:CI_Hormonal_CancerSeinActuel ;
    ptc:contientProgestatif ptc:Levonorgestrel ;
    ptc:forme "DIU hormonal" ;
    ptc:nomContraceptif "DIU hormonal lévonorgestrel - démonstration" ;
    ptc:peutProduire ptc:RisqueCancerSein,
        ptc:RisqueDepression,
        ptc:SaignementsIrreguliers .

ptc:EffetNeuropsychiatrique a owl:Class ;
    rdfs:label "Effet neuropsychiatrique"@fr ;
    rdfs:comment "Effet indésirable d’ordre neurologique ou psychiatrique."@fr ;
    rdfs:subClassOf ptc:EffetIndesirable .

ptc:ElevationTension a owl:NamedIndividual,
        ptc:RisqueCardiovasculaire ;
    rdfs:label "Élévation de la pression artérielle"@fr ;
    ptc:aggravePar ptc:Hypertension,
        ptc:Obesite ;
    ptc:descriptionEffet "Augmentation possible de la pression artérielle sous contraceptifs combinés." ;
    ptc:frequenceRisque "peu fréquent" ;
    ptc:niveauGravite "modéré" .

ptc:Hypertension a owl:NamedIndividual,
        ptc:ConditionClinique,
        ptc:FacteurDeRisque ;
    rdfs:label "Hypertension artérielle"@fr ;
    ptc:nomCondition "Hypertension artérielle" .

ptc:Implant_ETG a owl:NamedIndividual,
        ptc:ContraceptifHormonal ;
    rdfs:label "Implant à l’étonogestrel (démonstration)"@fr ;
    ptc:aContreIndication ptc:CI_Hormonal_CancerSeinActuel ;
    ptc:contientProgestatif ptc:Etonogestrel ;
    ptc:forme "implant" ;
    ptc:nomContraceptif "Implant étonogestrel - démonstration" ;
    ptc:peutProduire ptc:Acne,
        ptc:BaisseLibido,
        ptc:RisqueCancerSein,
        ptc:RisqueDepression,
        ptc:SaignementsIrreguliers .

ptc:MigraineAvecAura a owl:NamedIndividual,
        ptc:ConditionClinique,
        ptc:ConditionContreIndiqueCHC,
        ptc:FacteurDeRisque ;
    rdfs:label "Migraine avec aura"@fr ;
    ptc:nomCondition "Migraine avec aura" .

ptc:Monographie_IARC_100A a owl:NamedIndividual,
        ptc:Etude ;
    rdfs:label "Monographie du CIRC – volume 100A"@fr ;
    ptc:evalueContraceptif ptc:PiluleCombinee_EE_CPA,
        ptc:PiluleCombinee_EE_DRSP ;
    ptc:niveauPreuve "évaluation d'un organisme international" ;
    ptc:titreSource "IARC Monographs, volume 100A : contraceptifs combinés œstro-progestatifs (classement groupe 1)" .

ptc:Obesite a owl:NamedIndividual,
        ptc:ConditionClinique,
        ptc:FacteurDeRisque ;
    rdfs:label "Obésité (IMC ≥ 30)"@fr ;
    ptc:nomCondition "Obésité (IMC ≥ 30)" .

ptc:ProgestatifAntiAndrogenique a owl:Class ;
    rdfs:label "Progestatif anti-androgénique"@fr ;
    rdfs:comment "Sous-classe de progestatif décrite comme anti-androgénique."@fr ;
    rdfs:subClassOf ptc:Progestatif .

ptc:ProgestatifFaiblementAndrogenique a owl:Class ;
    rdfs:label "Progestatif faiblement androgénique"@fr ;
    rdfs:comment "Sous-classe de progestatif décrite comme faiblement androgénique."@fr ;
    rdfs:subClassOf ptc:Progestatif .

ptc:RecepteurAndrogene a owl:NamedIndividual,
        ptc:RecepteurHormonal ;
    rdfs:label "Récepteur des androgènes"@fr ;
    ptc:nomCible "Récepteur des androgènes" .

ptc:RecepteurHormonal a owl:Class ;
    rdfs:label "Récepteur hormonal"@fr ;
    rdfs:comment "Cible biologique de type récepteur hormonal."@fr ;
    rdfs:subClassOf ptc:CibleBiologique .

ptc:RisqueAVCIschemique a owl:NamedIndividual,
        ptc:RisqueCardiovasculaire ;
    rdfs:label "Risque d’AVC ischémique"@fr ;
    ptc:aggravePar ptc:Hypertension,
        ptc:MigraineAvecAura,
        ptc:Tabagisme ;
    ptc:descriptionEffet "Légère augmentation du risque d'AVC ischémique et d'infarctus sous contraceptifs combinés ; risque absolu faible mais plus élevé avec le tabac, l'hypertension, la migraine avec aura et l'âge." ;
    ptc:frequenceRisque "rare" ;
    ptc:justifiePar ptc:Etude_Lidegaard_NEJM2012 ;
    ptc:niveauGravite "grave" .

ptc:RisqueCardiovasculaire a owl:Class ;
    rdfs:label "Risque cardiovasculaire"@fr ;
    rdfs:comment "Catégorie d’effets indésirables potentiels cardiovasculaires."@fr ;
    rdfs:subClassOf ptc:EffetIndesirable .

ptc:RisqueThromboembolique a owl:NamedIndividual,
        ptc:RisqueCardiovasculaire ;
    rdfs:label "Risque thromboembolique"@fr ;
    ptc:aggravePar ptc:AntecedentThrombose,
        ptc:Obesite,
        ptc:Tabagisme ;
    ptc:descriptionEffet "Risque thromboembolique potentiel associé aux contraceptifs hormonaux combinés" ;
    ptc:frequenceRisque "rare" ;
    ptc:justifiePar ptc:Evaluation_EMA_CHC ;
    ptc:niveauGravite "grave" .

ptc:Tabagisme a owl:NamedIndividual,
        ptc:ConditionClinique,
        ptc:FacteurDeRisque ;
    rdfs:label "Tabagisme actif"@fr ;
    ptc:nomCondition "Tabagisme actif" .

ptc:justifiePar a owl:ObjectProperty ;
    rdfs:label "est justifié par"@fr ;
    rdfs:comment "Relie une contre-indication, un effet ou une interaction à une source documentaire."@fr ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ptc:ContreIndication ptc:EffetClinique ptc:Interaction ) ] ;
    rdfs:range ptc:Etude .

ptc:BaisseLibido a owl:NamedIndividual,
        ptc:EffetNeuropsychiatrique ;
    rdfs:label "Baisse de libido"@fr ;
    ptc:descriptionEffet "Baisse de libido rapportée par certaines utilisatrices ; causalité et intensité variables." ;
    ptc:frequenceRisque "variable" ;
    ptc:niveauGravite "léger à modéré" .

ptc:ConditionGynecologique a owl:Class ;
    rdfs:label "Condition gynécologique"@fr ;
    rdfs:comment "Condition clinique relevant du domaine gynécologique."@fr ;
    rdfs:subClassOf ptc:ConditionClinique .

ptc:SaignementsIrreguliers a owl:NamedIndividual,
        ptc:EffetIndesirable ;
    rdfs:label "Saignements irréguliers"@fr ;
    ptc:descriptionEffet "Modification possible du profil de saignement" ;
    ptc:niveauGravite "léger" .

ptc:contientMolecule a owl:ObjectProperty ;
    rdfs:label "contient la molécule"@fr ;
    rdfs:comment "Relie un contraceptif à une molécule qu’il contient."@fr ;
    rdfs:domain ptc:Contraceptif ;
    rdfs:range ptc:Molecule .

ptc:CYP3A4 a owl:NamedIndividual,
        ptc:CibleBiologique ;
    rdfs:label "Cytochrome P450 3A4 (CYP3A4)"@fr ;
    ptc:nomCible "Cytochrome P450 3A4" .

ptc:ConditionContreIndiqueCHC a owl:Class ;
    rdfs:label "Condition contre-indiquant les contraceptifs combinés"@fr ;
    rdfs:comment "Condition considérée dans le modèle pour l’analyse des restrictions liées aux contraceptifs hormonaux combinés (CHC)."@fr ;
    rdfs:subClassOf ptc:ConditionClinique .

ptc:Oestrogene a owl:Class ;
    rdfs:label "Œstrogène"@fr ;
    rdfs:comment "Molécule appartenant à la famille des œstrogènes."@fr ;
    rdfs:subClassOf ptc:Molecule .

ptc:RisqueTumoral a owl:Class ;
    rdfs:label "Risque tumoral (cancer ou tumeur)"@fr ;
    rdfs:comment "Catégorie d’effets indésirables potentiels de nature tumorale."@fr ;
    rdfs:subClassOf ptc:EffetIndesirable .

ptc:aCondition a owl:ObjectProperty ;
    rdfs:label "a pour condition"@fr ;
    rdfs:comment "Associe un profil simulé à une condition clinique."@fr ;
    rdfs:domain ptc:ProfilPatiente ;
    rdfs:range ptc:ConditionClinique .

ptc:CI_Hormonal_CancerSeinActuel a owl:NamedIndividual,
        ptc:ContreIndicationOncologique ;
    rdfs:label "Contre-indication hormonale – cancer du sein actuel"@fr ;
    ptc:categorieMEC 4 ;
    ptc:concerneCondition ptc:CancerSeinActuel ;
    ptc:concerneContraceptif ptc:DIU_Hormonal_LNG,
        ptc:Implant_ETG,
        ptc:Injectable_DMPA,
        ptc:PiluleCombinee_EE_CPA,
        ptc:PiluleCombinee_EE_DRSP,
        ptc:PiluleProgestative_DSG ;
    ptc:justifiePar ptc:Guide_CDC_USMEC_2024 ;
    ptc:niveauAlerte "signal rouge" .

ptc:CibleBiologique a owl:Class ;
    rdfs:label "Cible biologique"@fr ;
    rdfs:comment "Entité biologique ciblée ou associée à une molécule dans le modèle."@fr .

ptc:Guide_CDC_USMEC_2024 a owl:NamedIndividual,
        ptc:Etude ;
    rdfs:label "Guide CDC – U.S. MEC 2024"@fr ;
    rdfs:seeAlso <https://www.cdc.gov/mmwr/volumes/73/rr/rr7304a1.htm> ;
    ptc:evalueContraceptif ptc:PiluleCombinee_EE_DRSP ;
    ptc:niveauPreuve "recommandation officielle" ;
    ptc:titreSource "U.S. Medical Eligibility Criteria for Contraceptive Use, 2024" ;
    ptc:urlSource "https://www.cdc.gov/mmwr/volumes/73/rr/rr7304a1.htm"^^xsd:anyURI .

ptc:Interaction a owl:Class ;
    rdfs:label "Interaction"@fr ;
    rdfs:comment "Relation pharmacologique ou clinique pouvant modifier une propriété ou une efficacité étudiée."@fr .

ptc:PiluleProgestative_DSG a owl:NamedIndividual,
        ptc:ContraceptifHormonal,
        ptc:PiluleProgestative ;
    rdfs:label "Pilule progestative au désogestrel (démonstration)"@fr ;
    ptc:aContreIndication ptc:CI_Hormonal_CancerSeinActuel ;
    ptc:contientProgestatif ptc:Desogestrel ;
    ptc:forme "pilule progestative seule" ;
    ptc:nomContraceptif "Pilule progestative désogestrel - démonstration" ;
    ptc:peutProduire ptc:BaisseLibido,
        ptc:RisqueCancerSein,
        ptc:RisqueDepression,
        ptc:SaignementsIrreguliers .

ptc:RecepteurProgesterone a owl:NamedIndividual,
        ptc:RecepteurHormonal ;
    rdfs:label "Récepteur de la progestérone"@fr ;
    ptc:nomCible "Récepteur de la progestérone" .

ptc:RisqueCancerSein a owl:NamedIndividual,
        ptc:RisqueTumoral ;
    rdfs:label "Risque de cancer du sein"@fr ;
    ptc:descriptionEffet "Légère augmentation relative du risque de cancer du sein chez les utilisatrices actuelles ou récentes de contraceptifs hormonaux ; le risque absolu reste faible et diminue après l'arrêt." ;
    ptc:frequenceRisque "risque absolu faible" ;
    ptc:justifiePar ptc:Etude_Morch_NEJM2017,
        ptc:Monographie_IARC_100A ;
    ptc:niveauGravite "grave" .

ptc:RisqueDepression a owl:NamedIndividual,
        ptc:EffetNeuropsychiatrique ;
    rdfs:label "Risque de dépression"@fr ;
    ptc:descriptionEffet "Association statistique avec un diagnostic de dépression ou un traitement antidépresseur dans une grande cohorte ; la causalité individuelle est débattue et la réponse varie selon les personnes." ;
    ptc:frequenceRisque "variable" ;
    ptc:justifiePar ptc:Etude_Skovlund_JAMAPsy2016 ;
    ptc:niveauGravite "modéré à grave" .

ptc:EffetBenefique a owl:Class ;
    rdfs:label "Effet bénéfique"@fr ;
    rdfs:comment "Effet clinique favorable potentiel, distinct d’un effet indésirable."@fr ;
    rdfs:subClassOf ptc:EffetClinique .

ptc:EtudeClinique a owl:Class ;
    rdfs:label "Étude clinique"@fr ;
    rdfs:comment "Source de type étude clinique ; les exemples purement synthétiques doivent être explicitement identifiés."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptc:evalueContraceptif ;
            owl:someValuesFrom ptc:Contraceptif ],
        ptc:Etude .

ptc:FacteurDeRisque a owl:Class ;
    rdfs:label "Facteur de risque"@fr ;
    rdfs:comment "Condition clinique jouant le rôle de facteur de risque dans le modèle."@fr ;
    rdfs:subClassOf ptc:ConditionClinique .

ptc:Observation a owl:Class ;
    rdfs:label "Observation de suivi"@fr ;
    rdfs:comment "Observation liée au suivi fictif d’un profil patient simulé."@fr .

ptc:ContraceptifHormonal a owl:Class ;
    rdfs:label "Contraceptif hormonal"@fr ;
    rdfs:comment "Contraceptif associé à au moins une molécule hormonale, suivant la modélisation de l’ontologie."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptc:contientMolecule ;
            owl:someValuesFrom ptc:Molecule ],
        ptc:Contraceptif .

ptc:ContreIndication a owl:Class ;
    rdfs:label "Contre-indication"@fr ;
    rdfs:comment "Restriction clinique représentée comme entité et reliée à une condition et/ou à un contraceptif."@fr .

ptc:EffetClinique a owl:Class ;
    rdfs:label "Effet clinique"@fr ;
    rdfs:comment "Conséquence ou manifestation clinique considérée dans l’étude."@fr .

ptc:PiluleCombinee_EE_CPA a owl:NamedIndividual,
        ptc:ContraceptifHormonal ;
    rdfs:label "Pilule EE / acétate de cyprotérone (démonstration)"@fr ;
    ptc:aContreIndication ptc:CI_CHC_AntecedentThrombose,
        ptc:CI_CHC_MigraineAura,
        ptc:CI_CHC_TumeurHepatique,
        ptc:CI_CPA_Meningiome,
        ptc:CI_Hormonal_CancerSeinActuel ;
    ptc:contientOestrogene ptc:Ethinylestradiol ;
    ptc:contientProgestatif ptc:CyproteroneAcetate ;
    ptc:forme "pilule combinée" ;
    ptc:nomContraceptif "Pilule combinée EE/acétate de cyprotérone - démonstration" ;
    ptc:peutProcurer ptc:AmeliorationAcne,
        ptc:ReductionRisqueCancerEndometre,
        ptc:ReductionRisqueCancerOvaire,
        ptc:RegularisationSaignements ;
    ptc:peutProduire ptc:BaisseLibido,
        ptc:ElevationTension,
        ptc:LithiaseBiliaire,
        ptc:ModificationHumeur,
        ptc:RisqueAVCIschemique,
        ptc:RisqueCancerColUterin,
        ptc:RisqueCancerSein,
        ptc:RisqueDepression,
        ptc:RisqueMeningiome,
        ptc:RisqueThromboembolique,
        ptc:RisqueTumeurHepatique .

ptc:EffetIndesirable a owl:Class ;
    rdfs:label "Effet indésirable"@fr ;
    rdfs:comment "Effet clinique défavorable potentiel associé dans le modèle à une exposition."@fr ;
    rdfs:subClassOf ptc:EffetClinique .

ptc:Progestatif a owl:Class ;
    rdfs:label "Progestatif"@fr ;
    rdfs:comment "Molécule progestative de la classification."@fr ;
    rdfs:subClassOf ptc:Molecule .

ptc:Etude a owl:Class ;
    rdfs:label "Source de preuve"@fr ;
    rdfs:comment "Source documentaire ou élément de preuve modélisé pour la traçabilité des énoncés."@fr .

ptc:Molecule a owl:Class ;
    rdfs:label "Molécule"@fr ;
    rdfs:comment "Substance chimique ou pharmacologique intervenant dans le modèle."@fr .

ptc:PiluleCombinee_EE_DRSP a owl:NamedIndividual,
        ptc:ContraceptifHormonal ;
    rdfs:label "Pilule EE / drospirénone (démonstration)"@fr ;
    ptc:aContreIndication ptc:CI_CHC_AntecedentThrombose,
        ptc:CI_CHC_MigraineAura,
        ptc:CI_CHC_TumeurHepatique,
        ptc:CI_DRSP_InsuffisanceRenale,
        ptc:CI_Hormonal_CancerSeinActuel ;
    ptc:contientOestrogene ptc:Ethinylestradiol ;
    ptc:contientProgestatif ptc:Drospirenone ;
    ptc:forme "pilule combinée" ;
    ptc:nomContraceptif "Pilule combinée EE/drospirénone - démonstration" ;
    ptc:peutProcurer ptc:AmeliorationAcne,
        ptc:ReductionRisqueCancerEndometre,
        ptc:ReductionRisqueCancerOvaire,
        ptc:RegularisationSaignements ;
    ptc:peutProduire ptc:BaisseLibido,
        ptc:ElevationTension,
        ptc:LithiaseBiliaire,
        ptc:ModificationHumeur,
        ptc:RisqueAVCIschemique,
        ptc:RisqueCancerColUterin,
        ptc:RisqueCancerSein,
        ptc:RisqueDepression,
        ptc:RisqueHyperkaliemie,
        ptc:RisqueThromboembolique,
        ptc:RisqueTumeurHepatique .

ptc:ConditionClinique a owl:Class ;
    rdfs:label "Condition clinique"@fr ;
    rdfs:comment "Condition clinique ou facteur de santé utilisé pour décrire un profil simulé."@fr .

ptc:Contraceptif a owl:Class ;
    rdfs:label "Contraceptif"@fr ;
    rdfs:comment "Méthode ou produit contraceptif représenté comme entité d’étude."@fr .

ptc:ProfilPatiente a owl:Class ;
    rdfs:label "Profil patiente simulé"@fr ;
    rdfs:comment "Profil de patiente fictive, sans données d’une personne réelle."@fr .

[] a owl:AllDisjointClasses ;
    owl:members ( ptc:Oestrogene ptc:Progestatif ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptc:PiluleCombinee ptc:PiluleProgestative ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptc:ContraceptifHormonal ptc:ContraceptifNonHormonal ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptc:ProgestatifAndrogenique ptc:ProgestatifFaiblementAndrogenique ptc:ProgestatifAntiAndrogenique ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptc:ProfilPatiente ptc:ConditionClinique ptc:Contraceptif ptc:Molecule ptc:CibleBiologique ptc:Interaction ptc:EffetClinique ptc:ContreIndication ptc:Etude ptc:Observation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptc:EffetIndesirable ptc:EffetBenefique ) .

