FROM python:3.11-slim
WORKDIR /app
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && python -m spacy download fr_core_news_sm
COPY backend/nlp/requirements.txt /tmp/nlp-requirements.txt
RUN pip install --no-cache-dir -r /tmp/nlp-requirements.txt
COPY . /app
EXPOSE 8000
CMD ["python", "-m", "backend.scripts.start_backend"]
